#!/bin/bash
# ceph-test-health [component...]: exit 0 if every named component is ready.
# The entrypoint marks each component when it is ready, at the same time it
# logs its ready line, so this only reads the markers: no ceph command, which
# could stall on a busy machine and flap the container's health.
#
# Components: base (mon, mgr, osd and its capacity reported - the default,
# used by the Docker HEALTHCHECK), rgw, s3-user, rgw-seed, device-class, rbd,
# cephfs, orchestrator, prometheus, dashboard, all (every enabled component).
STATE_DIR=/run/ceph-test

[ $# -eq 0 ] && set -- base
for c in "$@"; do
    if [ ! -f "${STATE_DIR}/${c}" ]; then
        if [ -f "${STATE_DIR}/enabled" ] && ! grep -qx -- "$c" "${STATE_DIR}/enabled"; then
            echo "${c}: not enabled"
        else
            echo "${c}: not ready"
        fi
        exit 1
    fi
done
echo "ready: $*"
